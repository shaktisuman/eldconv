# What a tinyconfig arm64 kernel needs on top to boot an initramfs on qemu's virt machine and
# say so on the serial console. configure.sh appends this to .config and runs olddefconfig.
CONFIG_EXPERT=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_PSCI_FW=y
# A relocatable arm64 kernel links with --no-apply-dynamic-relocs and RELR, which eld does not
# implement (eldconv drops the flag); eld's own kernel boot workflow turns these off the same way.
# CONFIG_RELOCATABLE is not set
# CONFIG_RANDOMIZE_BASE is not set
